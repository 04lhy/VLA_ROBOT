# Copy to .env, fill in the values, then run: set -a; source .env; set +a
# .env is not loaded automatically. Never commit your actual API keys.
DASHSCOPE_API_KEY=
DASHSCOPE_WORKSPACE=
DASHSCOPE_REGION=cn-beijing

# Optional Omni overrides. The URL is inferred from workspace and region if empty.
DASHSCOPE_BASE_URL=
AGENT_OMNI_MODEL=qwen3.8-omni-flash
AGENT_OMNI_REALTIME_MODEL=qwen3.8-omni-flash-realtime
# Optional; inferred from workspace/region when empty, independently of the HTTP URL.
DASHSCOPE_REALTIME_URL=

# Only needed for the ASR + real DeepSeek planner backend.
DEEPSEEK_API_KEY=
