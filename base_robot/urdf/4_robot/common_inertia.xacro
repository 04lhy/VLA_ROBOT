<?xml version="1.0"?>
<robot xmlns:xacro="http://www.ros.org/wiki/xacro">
    <!-- 立方体惯性参数宏 -->
    <xacro:macro name="box_inertia" params="m w h d">
        <inertial>
            <mass value="${m}" />
            <!-- 修正标签：inertial → inertia -->
            <inertia ixx="${m * (h * h + d * d) / 12.0}" 
                     iyy="${m * (w * w + d * d) / 12.0}" 
                     izz="${m * (w * w + h * h) / 12.0}" 
                     ixy="0" ixz="0" iyz="0" /> 
        </inertial>
    </xacro:macro>
    
    <!-- 圆柱体惯性参数宏 -->
    <xacro:macro name="cylinder_inertia" params="m r h">
        <inertial>
            <mass value="${m}" />
            <!-- 修正标签：inertial → inertia -->
            <inertia ixx="${m * (3.0 * r * r + h * h) / 12.0}" 
                     iyy="${m * (3.0 * r * r + h * h) / 12.0}" 
                     izz="${m * r * r / 2.0}" 
                     ixy="0" ixz="0" iyz="0" /> 
        </inertial>
    </xacro:macro>

    <!-- 球体惯性参数宏 -->
    <xacro:macro name="sphere_inertia" params="m r">
        <inertial>
            <mass value="${m}" />
            <!-- 修正标签：inertial → inertia -->
            <inertia ixx="${m * 2.0 / 5.0 * r * r}" 
                     iyy="${m * 2.0 / 5.0 * r * r}" 
                     izz="${m * 2.0 / 5.0 * r * r}" 
                     ixy="0" ixz="0" iyz="0" /> 
        </inertial>
    </xacro:macro>
</robot>