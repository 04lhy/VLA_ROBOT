<?xml version="1.0"?>
<robot xmlns:xacro="http://www.ros.org/wiki/xacro">
    <xacro:macro name="caster_wheel" params="caster_name xyz">
        <link name="${caster_name}_caster_link">
            <visual> 
                <origin xyz="0 0 0" rpy="1.57079 0 0"/>
                <geometry>
                    <sphere radius="0.032"/>
                </geometry>
                <material name = "yellow">
                    <color rgba="1.0 1.0 0.0 0.8"/>
                </material>
            </visual>
            <collision>
                <origin xyz="0 0 0" rpy="0 0 0"/>
                <geometry>
                    <sphere radius="0.032"/>
                </geometry>
            </collision>
            
            <xacro:sphere_inertia m="0.5" r="0.032"/>
        </link>

        <joint name="${caster_name}_caster_joint" type="fixed">
            <parent link="base_link"/>
            <child link="${caster_name}_caster_link"/>
            <origin xyz="${xyz}"/>
            <axis xyz="0.0 1.0 0.0"/>
        </joint>

        <gazebo reference="${caster_name}_caster_link">
            <kp>10000000.0</kp>   
            <kd>100.0</kd>        
            <minDepth>0.001</minDepth> 
            <mu1>0.0</mu1>        
            <mu2>0.0</mu2>
        </gazebo>
    </xacro:macro>
</robot>