  <joint name="zhichengjia_joint" type="fixed">
    <parent link="base_link"/>
    <child link="zhicheng_ban"/>
    <origin xyz="0.0 0.0 0.2"/>
  </joint>
  <joint name="arm_joint" type="fixed">
    <parent link="zhicheng_ban"/>
    <child link="arm_base_link"/>
    <origin xyz="0.0 0.0 0.01"/>
