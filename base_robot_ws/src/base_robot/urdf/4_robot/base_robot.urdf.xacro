<?xml version="1.0"?>
<robot xmlns:xacro="http://www.ros.org/wiki/xacro" name="base_robot_4">
    <xacro:include filename="$(find base_robot)/urdf/4_robot/common_inertia.xacro"/>
    <!-- 基础模型-->
    <xacro:macro name = "base_xacro" params = "length radius mass">
        <!--虚拟部件贴合地面-->
        <link name="base_link">
            <visual>
                <geometry>
                    <cylinder length="${length}" radius="${radius}"/>
                </geometry>
                <material name = "blue">
                    <color rgba="0.5 0.5 1.0 1.0" />
                </material>
            </visual>
            <collision>
                <origin xyz="0 0 0" rpy="0 0 0"/>
                <geometry>
                    <cylinder length="${length}" radius="${radius}"/>
                </geometry>
                <material name = "blue">
                    <color rgba="0.5 0.5 1.0 1.0" />
                </material>
            </collision>
            <xacro:cylinder_inertia m="${mass}" r="${radius}" h="${length}"/>
        </link>

        <link name="base_footprint"/>
        <joint name="base_footprint_joint" type="fixed">
            <parent link="base_footprint"/>
            <child link="base_link"/>
            <origin xyz="0 0 ${length/2.0+0.032-0.001}" rpy="0 0 0"/>
        </joint>
    </xacro:macro>

</robot>
