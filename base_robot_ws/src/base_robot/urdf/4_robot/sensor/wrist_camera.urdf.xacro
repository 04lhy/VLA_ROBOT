<?xml version="1.0"?>
<robot xmlns:xacro="http://www.ros.org/wiki/xacro">
    <xacro:macro name="wrist_camera_xacro" params="xyz">
        <!-- ============腕部摄像头模块================ -->
        <!-- 连接杆：圆柱，从 link6 延伸到摄像头位置 -->
        <link name="wrist_camera_mount">
            <visual>
                <origin xyz="0 0 0" rpy="0 0 0" />
                <geometry>
                    <cylinder radius="0.006" length="0.04" />
                </geometry>
                <material name="dark_grey">
                    <color rgba="0.3 0.3 0.3 0.9"/>
                </material>
            </visual>
            <collision>
                <origin xyz="0 0 0" rpy="0 0 0" />
                <geometry>
                    <cylinder radius="0.006" length="0.04" />
                </geometry>
            </collision>
            <inertial>
                <origin xyz="0 0 0" rpy="0 0 0" />
                <mass value="0.005" />
                <inertia ixx="1e-6" ixy="0" ixz="0" iyy="1e-6" iyz="0" izz="1e-6" />
            </inertial>
        </link>

        <!-- 摄像头本体方盒 -->
        <link name="wrist_camera_link">
            <visual>
                <origin xyz="0 0 0" rpy="0 0 0" />
                <geometry>
                    <box size="0.015 0.035 0.015" />
                </geometry>
                <material name="grey">
                    <color rgba="0.5 0.5 0.5 0.8"/>
                </material>
            </visual>
            <collision>
                <origin xyz="0 0 0" rpy="0 0 0" />
                <geometry>
                    <box size="0.015 0.035 0.015" />
                </geometry>
            </collision>
            <xacro:box_inertia m="0.01" w="0.015" h="0.035" d="0.015" />
        </link>

        <link name="wrist_camera_optical_link"></link>

        <!-- 连接杆固定到 link6 -->
        <joint name="wrist_camera_mount_joint" type="fixed">
            <parent link="link6" />
            <child link="wrist_camera_mount" />
            <origin xyz="${xyz}" rpy="0 ${pi/2} 0" />
        </joint>

        <!-- 摄像头方盒固定到连接杆末端 -->
        <joint name="wrist_camera_bracket_joint" type="fixed">
            <parent link="wrist_camera_mount" />
            <child link="wrist_camera_link" />
            <origin xyz="0 0 0.02" rpy="0 -0.3 0" />
        </joint>

        <!-- 光学坐标系转换 -->
        <joint name="wrist_camera_optical_joint" type="fixed">
            <parent link="wrist_camera_link" />
            <child link="wrist_camera_optical_link" />
            <origin xyz="0 0 0" rpy="${-pi/2} 0 ${-pi/2}" />
        </joint>
    </xacro:macro>
</robot>
