# ==========================================
# 1. 大模型与深度学习 (AI Models & Deep Learning)
# ==========================================
# 绝对禁止上传动辄十几 GB 的权重文件
*.pt
*.pth
*.bin
*.safetensors
*.ckpt
*.onnx
*.h5
*.pb

# 忽略微调时产生的海量检查点和日志文件
checkpoints/
logs/
runs/
wandb/
adapter_config.json

# ==========================================
# 2. 机器人数据集与多媒体 (Datasets & Media)
# ==========================================
# 录制的传感器数据和图像非常大，不要进 Git
data/
datasets/
vla_demos/
*.bag
*.mcap
*.mp4
*.avi
*.jpg
*.png

# ==========================================
# 3. ROS 2 工作空间编译产物 (ROS 2 Colcon)
# ==========================================
# 每次 colcon build 都会重新生成这些，必须忽略
build/
install/
log/

# ==========================================
# 4. Python 与虚拟环境 (Python & Environments)
# ==========================================
__pycache__/
*.py[cod]
*$py.class
*.so

# 环境变量与隔离环境
.env
.venv
env/
venv/
.conda/
ENV/

# Jupyter Notebook 临时文件
.ipynb_checkpoints

# ==========================================
# 5. IDE 与操作系统缓存 (IDE & OS)
# ==========================================
.vscode/
.idea/
*.swp
*.swo
*.vc.db*
.DS_Store
Thumbs.db

# ==========================================
# 6. Claude Code / AI 工具
# ==========================================
.claude/
.memory/
